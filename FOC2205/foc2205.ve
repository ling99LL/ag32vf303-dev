##############################################################################
# FOC2205 pin map — AG32VF303KCU6 (QFN32, logic_device = AGRV2KQ32)
#
# ZERO CRYSTAL OCCUPANCY & JTAG DEBUG UNAFFECTED:
#  * Debugger pins reserved: PIN_24 (JTMS), PIN_25 (JTCK), PIN_26 (JTDI), PIN_27 (JTDO).
#    DAPLink talks 2-wire Compact-JTAG (TCK/TMS) only; PIN_28 (JNTRST) is free to
#    reuse (TAP reset also works via 5 TMS-high clocks, nTRST is optional).
#  * Crystal 2 pins completely reserved for HSE oscillator:
#    PIN_2 (OSC_IN), PIN_3 (OSC_OUT)
#  * Hard SPI is fixed mode 0. MT6701 SSI and DRV8316 SPI both need mode 1,
#    so SPI0/SPI1 route through logic fabric (spi_mode_wrap).
#  * GPIO0_0/GPIO0_1 share physical bits with SPI0_SI/SO; CSN/nSLEEP use GPIO2_x.
#  * PIN_10/11/12 = ADC_IN3/IN4/IN5 fixed analog pads -> current sensing.
#  * PIN_22/PIN_23 (USBDM/USBDP IO pads) used for BRK and MT6701 MISO.
#  * UART0 debug console on die pads PIN_20/21.
#  * PIN_28 (JNTRST) used for DRV8316 INL_ALL; PIN_1 freed; PIN_15/BOOT1 100% free.
##############################################################################

SYSCLK 200
BUSCLK 100
HSECLK 8

# ---- Three-phase PWM, direct (3x PWM mode -> DRV8316 INHA/B/C) ----
GPTIMER0_CH0   PIN_7          # PWM_A -> INHA
GPTIMER0_CH1   PIN_8          # PWM_B -> INHB
GPTIMER0_CH2   PIN_9          # PWM_C -> INHC

# ---- Hardware brake: nFAULT (open drain, low = fault) -> GPTIMER0_BRK ----
# Reassigned from PIN_26 (JTDI) to PIN_22 (clean IO, no JTAG conflict)
GPTIMER0_BRK   PIN_22         # BRK polarity = low (BKP=0)

# ---- SPI0 -> mode-1 bridge -> DRV8316C (6.25 MHz, 16-clock frames) ----
SPI0_SCK       spi0_sck_f     # MCU function -> logic wire
SPI0_SI_IO0    spi0_mosi_f:OUTPUT
SPI0_CSN       spi0_csn_f
spi0_sck_o     PIN_18:OUTPUT  # bridge output -> DRV8316 SCLK
spi0_mosi_o    PIN_19:OUTPUT  # bridge output -> DRV8316 SDI
spi0_csn_o     PIN_31:OUTPUT  # bridge output -> DRV8316 nSCS (shaped)
spi0_miso_i    PIN_29:INPUT   # DRV8316 SDO -> bridge capture

# ---- SPI1 -> mode-1 bridge -> MT6701 SSI (12.5 MHz, 24-clock frames) ----
SPI1_SCK       spi1_sck_f
SPI1_CSN       spi1_csn_f     # used only as bridge gate (CSN itself = GPIO2_0)
spi1_sck_o     PIN_13:OUTPUT  # bridge output -> MT6701 CLK
# Reassigned from PIN_28 (JNTRST) to PIN_23 (clean IO, no JTAG conflict)
spi1_miso_i    PIN_23:INPUT   # MT6701 DO -> bridge capture

# ---- GPIO (free bits — GPIO2_x, NOT GPIO0_x) ----
GPIO2_0        spi1_csn_g     # MT6701 CSN, firmware-timed (>=100ns setup)
spi1_csn_go    PIN_14:OUTPUT  # logic pass-through to pad
GPIO2_1        PIN_5          # DRV8316 nSLEEP (direct GPIO, 10k pull-up on pad)
GPIO2_2        PIN_28         # DRV8316 INL_A/B/C common enable (PIN_1 -> PIN_28/JNTRST)

# ---- Debug serial console (die-fixed UART0 pads) ----
UART0_UARTTXD  PIN_20
UART0_UARTRXD  PIN_21
