import io
p = r'C:\Users\Administrator\Documents\AG32\FOC2205\experiments\tests\current_loop\snap_walk.py'
t = io.open(p, 'r', encoding='utf-8', newline='').read()
old = "        if fault:\n            say('    walk %s faulted:"
assert t.count(old) == 1, ('anchor count', t.count(old))
ins = ("        say('    walk %s %s after %.1fs' % (cmd, 'FAULT' if fault else "
       "('done' if done else 'TIMEOUT'), time.monotonic() - t0))\n")
t = t.replace(old, ins + old)
io.open(p, 'w', encoding='utf-8', newline='').write(t)
print('patched')
