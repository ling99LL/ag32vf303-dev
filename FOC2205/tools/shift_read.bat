@echo off
"C:/Users/Administrator/.platformio/packages/tool-agrv_openocd/bin/openocd_cmd.bat" -s "C:/Users/Administrator/.platformio/platforms/AgRV/etc" -c "variable ADAPTER_SPEED 10000" -c "variable ADAPTER cmsis-dap" -f agrv2k.cfg -c "halt" -c "mem2array SH 32 0x20000ee8 3" -c "puts \"SHIFT0=0x[format %%08x $SH(0)]\"" -c "puts \"SHIFT1=0x[format %%08x $SH(1)]\"" -c "puts \"SHIFT2=0x[format %%08x $SH(2)]\"" -c "mem2array M 32 0x20000ed8 2" -c "puts \"RAW0=0x[format %%06x $M(0)]\"" -c "mem2array S 32 0x20000f1c 1" -c "puts \"STAGE=[format %%d $S(0)]\"" -c "resume" -c "shutdown"
