# pio_begin  >>>>>> DO NOT MODIFY THIS SECTION! >>>>>>
if { [info exists BOARD_PLL_CLKIN] } {
  if { $BOARD_PLL_CLKIN == "PIN_OSC" } {
    set_config -loc 18 0 0 CFG_RCOSC_EN 1'b1
  }
}
if { [info exists USB0_MODE] } {
  alta::tcl_info "USB0_MODE = $USB0_MODE"
  set_config -loc 0 1 3 CFG_PULLUP_ENB 1'b0
  set_config -loc 0 1 3 CFG_PULLDN_ENB 1'b0
}
# pio_end    <<<<<< DO NOT MODIFY THIS SECTION! <<<<<<

# ---------------------------------------------------------------------------
# User design extensions (preserved by prelogic; sourced by af_run.tcl).
# Bind the DAC0 hard macro to its fixed silicon location so that the apb_dac
# instance inside analog_ip.v drives pad PIN_11 (QFN32 package).
#   {22 11} = DAC0 -> PIN_11, {22 12} = DAC1 -> PIN_12 (not routed on this board).
# ---------------------------------------------------------------------------
set_instance_assignment -extension -name FIXED_COORD -to macro_inst|gen_per[3].*gen_dac.dac_inst|dac_inst {22 11}

